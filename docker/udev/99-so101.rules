# Linux only: stable device names so /dev/ttyACM0 vs ACM1 never swap after a reboot.
# 1. Plug ONE arm and run:  udevadm info -a -n /dev/ttyACM0 | grep -E '{serial}|{idVendor}|{idProduct}' | head -3
# 2. Paste each arm's serial below, then:
#      sudo cp docker/udev/99-so101.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# 3. In .env: FOLLOWER_PORT=/dev/so101_follower  LEADER_PORT=/dev/so101_leader
# (1a86:55d3 is the CH343 USB-serial chip on the common SO101 driver boards; check yours in step 1.)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="REPLACE_FOLLOWER_SERIAL", SYMLINK+="so101_follower", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="REPLACE_LEADER_SERIAL", SYMLINK+="so101_leader", MODE="0666"
