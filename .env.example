# =============================================================================
# SO101 project configuration — the single source of truth.
# Copy to `.env` and edit:   cp .env.example .env
# Every script in scripts/ and every docker compose service reads this file.
# =============================================================================

# ---- Hugging Face -----------------------------------------------------------
# Datasets and trained policies travel PC -> Hub -> Spark (and back).
HF_USER=your-hf-username
# Token with WRITE access (https://huggingface.co/settings/tokens). Never commit `.env`.
HF_TOKEN=

# Where LeRobot keeps calibration files, datasets and model cache.
# Kept inside the project so you can see (and back up) everything.
#   calibration -> ${HF_LEROBOT_HOME}/calibration/{robots,teleoperators}/so_*/<ID>.json
#   datasets    -> ${HF_LEROBOT_HOME}/<HF_USER>/<DATASET_NAME>
# Native runs resolve this relative to the project root; containers mount ./data at /workspace/data.
HF_HOME=data/huggingface
HF_LEROBOT_HOME=data/huggingface/lerobot

# ---- Arms (USB serial) ------------------------------------------------------
# Find them with: scripts/01_find_port.sh
#   macOS:  /dev/tty.usbmodemXXXXXXXXXX
#   Linux:  /dev/serial/by-id/usb-…-if00  (from `ls -l /dev/serial/by-id/`, README §4.2)
FOLLOWER_PORT=/dev/tty.usbmodem_FOLLOWER
LEADER_PORT=/dev/tty.usbmodem_LEADER
# The ID names the calibration file. Keep it IDENTICAL in every command, forever.
FOLLOWER_ID=so101_follower
LEADER_ID=so101_leader

# ---- Cameras ----------------------------------------------------------------
# CAMERA_MODE=zmq    -> every process reads frames from the camera server (recommended)
# CAMERA_MODE=opencv -> the process opens the USB camera itself (debug / no server)
CAMERA_MODE=zmq
# Where the camera server runs, as seen by the robot processes (same PC -> 127.0.0.1).
CAMERA_SERVER_HOST=127.0.0.1
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
# Camera NAMES become the policy's input keys: observation.images.<name>.
# They must match what the pretrained policy expects (look at its config.json).
# camera1/camera2 suit SmolVLA-based policies; many community SO101 policies use e.g. front/wrist.
# CAM1 = fixed front/top view, CAM2 = wrist.
CAM1_NAME=front
CAM2_NAME=wrist
# *_DEVICE = numeric OpenCV index from scripts/04_find_cameras.sh (Linux: the N of /dev/video<N> from `v4l2-ctl --list-devices`, README §4.2)
CAM1_DEVICE=0
CAM1_PORT=5555
CAM2_DEVICE=1
CAM2_PORT=5556
# Leave empty on macOS. "MJPG" on Linux lets USB2 hubs carry 2x 640x480@30.
CAMERA_FOURCC=

# ---- Data collection --------------------------------------------------------
DATASET_NAME=so101_pick_cube
TASK="Pick up the cube and place it in the box"
NUM_EPISODES=50
# Max length of one episode. End it earlier with the right arrow key when the task is done.
EPISODE_TIME_S=60
RESET_TIME_S=15
PUSH_TO_HUB=true
# Open the rerun viewer while teleoperating/recording (always off inside Docker containers)
DISPLAY_DATA=true

# ---- Inference --------------------------------------------------------------
# The pretrained policy to run, from the Hugging Face Hub (see README §9).
# POLICY_TYPE must match the model's config.json "type": smolvla, act, ...
# Joint units: true = degrees. Must match the policy (BoyuZhao ACT was trained in degrees).
USE_DEGREES=true
POLICY_TYPE=act
# Hub id or a path VISIBLE ON THE SPARK (the server loads the weights, not the PC).
POLICY_PATH=BoyuZhao/so101-act-pick-and-place
# IP / hostname of the DGX Spark on your LAN.
SPARK_HOST=192.168.10.6
POLICY_SERVER_PORT=8090
POLICY_DEVICE=cuda
ACTIONS_PER_CHUNK=50
CHUNK_SIZE_THRESHOLD=0.5
# How a new chunk merges with queued actions: weighted_average (0.3 old + 0.7 new),
# latest_only (new fully replaces old), average, conservative (0.7 old + 0.3 new).
AGGREGATE_FN=weighted_average

# ---- Training (out of scope for the Academy; only used by scripts/09_train.sh) ----
TRAIN_STEPS=20000
BATCH_SIZE=64
# Name of the trained policy (output folder + Hub repo HF_USER/POLICY_NAME).
POLICY_NAME=act_so101_pick_place_ft
# ACT only: start from this checkpoint (fine-tune) instead of from scratch. Empty = from scratch.
BASE_POLICY=BoyuZhao/so101-act-pick-and-place
